{
  "name": "push_token",
  "method": "PUT",
  "path": "/v1/mobile/legacy/push-token",
  "adapts": "PUT /v1/mobile/push-token",
  "source": "New mobile contract (docs/openapi.yaml, TEC-91; the body keeps the previous mobile API's expo_push_token + platform).",
  "request": {
    "headers": {"Authorization": "Bearer {{access_token}}"},
    "body": {"expo_push_token": "{{expo_push_token}}", "platform": "android"}
  },
  "response": {
    "status": 200,
    "data_keys": ["uuid", "device_id", "platform", "last_seen_at"]
  }
}
