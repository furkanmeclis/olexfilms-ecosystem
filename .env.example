# Copy to .env for local/host development.
# compose.local.yml supplies service DNS to containers; host apps use 127.0.0.1.
# For production, copy to .env.server and replace every secret before make prod-config.

# --- Identity / naming (set before first deploy; services share hosts) ---
NAME_PREFIX=olexfilms
COMPOSE_PROJECT_NAME=olexfilms
LOCAL_NETWORK_NAME=olexfilms
APP_NETWORK_NAME=olexfilms-app
POSTGRES_VOLUME_NAME=olexfilms-postgres
REDIS_VOLUME_NAME=olexfilms-redis
SEAWEEDFS_VOLUME_NAME=olexfilms-seaweedfs
MEILI_VOLUME_NAME=olexfilms-meilisearch
WUZAPI_VOLUME_NAME=olexfilms-wuzapi
BACKEND_IMAGE=olexfilms-backend:local
FRONTEND_IMAGE=olexfilms-frontend:local


# --- App ---
APP_NAME=olexfilms
APP_ENV=development
APP_HTTP_ADDR=:8080
# Brand used when the request host matches no brand domain (K3).
DEFAULT_BRAND_SLUG=olex
LOG_LEVEL=debug
LOG_FORMAT=json

# --- Error tracking (Sentry SDK → technowide errortracking, K17) ---
# DSN: https://<32 hex key>@<technowide host>/<source id>. Empty = SDK off
# (no-op; local dev and CI). Not a secret: the browser DSN ships in the bundle.
SENTRY_DSN=
# Defaults to APP_ENV.
SENTRY_ENVIRONMENT=
# Defaults to the version baked in at image build (Docker build arg).
SENTRY_RELEASE=
# Browser SDK (baked in at `next build`; empty = no client reporting).
# Envelopes go through the same-origin /api/monitoring tunnel.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=

# --- Postgres (host → published port) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=app
DB_PASSWORD=change_me
DB_NAME=app
DB_SSLMODE=disable
POSTGRES_PORT=5432

# --- Redis ---
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0

# --- Object storage (SeaweedFS, S3 API) ---
# The bucket is private (no anonymous access). Browsers never reach storage:
# the API streams every object (logo_url / public_url / downloads).
STORAGE_DRIVER=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=s3admin
S3_SECRET_KEY=s3admin-secret
S3_BUCKET=app
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
S3_PORT=9000
# Sign SeaweedFS filer / volume traffic so only its S3 gateway can read or
# write objects (openssl rand -hex 32; required in production).
SEAWEEDFS_JWT_WRITE_KEY=local-seaweedfs-write-key
SEAWEEDFS_JWT_READ_KEY=local-seaweedfs-read-key

# --- Centrifugo ---
CENTRIFUGO_ENABLED=true
CENTRIFUGO_PORT=8000
CENTRIFUGO_API_URL=http://127.0.0.1:8000
CENTRIFUGO_API_KEY=app-centrifugo-api-key-change-me
CENTRIFUGO_TOKEN_HMAC_SECRET=app-centrifugo-token-hmac-change-me
CENTRIFUGO_WS_URL=ws://127.0.0.1:8000/connection/websocket
CENTRIFUGO_TOKEN_TTL=1h
CENTRIFUGO_ALLOWED_ORIGINS=http://localhost:3000 http://127.0.0.1:3000

# --- JWT ---
JWT_ACCESS_SECRET=app-dev-access-secret-change-me-32b
JWT_REFRESH_SECRET=app-dev-refresh-secret-change-me-32b
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
# Mobile app sessions (TEC-91): refresh lifetime (30 days).
JWT_MOBILE_REFRESH_TTL=720h

# --- Mobile API (TEC-91) ---
# Supported X-Mobile-Api-Version range (integer majors); others get 426.
MOBILE_API_MIN_VERSION=1
MOBILE_API_MAX_VERSION=1
# QR web sign-in challenge lifetime.
QR_LOGIN_TTL=120s

# --- Mail (MailHog locally) ---
MAIL_DRIVER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@localhost
SMTP_FROM=noreply@localhost
MAIL_FROM_NAME=App
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
ADMINER_PORT=8081

# --- Search (Meilisearch) ---
SEARCH_ENABLED=true
SEARCH_DRIVER=meilisearch
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=app-dev-meili-master-key-change-me
MEILI_INDEX_PREFIX=app
MEILI_PORT=7700

# --- WhatsApp gateway (wuzapi, design K16/K21) ---
# Admin API token (openssl rand -hex 32). The backend creates the session user.
WUZAPI_URL=http://127.0.0.1:8082
WUZAPI_PORT=8082
WUZAPI_ADMIN_TOKEN=app-dev-wuzapi-admin-token-change-me
# Webhook HMAC secret: wuzapi signs, backend verifies.
WUZAPI_WEBHOOK_SECRET=app-dev-wuzapi-webhook-secret-change-me
# AES key for stored WhatsApp session secrets: exactly 32 characters
# (openssl rand -hex 16). Never rotate (sessions are lost).
WUZAPI_GLOBAL_ENCRYPTION_KEY=app-dev-wuzapi-encryption-key-32
# Webhook target (backend POST /hooks/wuzapi, HMAC-signed with
# WUZAPI_WEBHOOK_SECRET). Local: the host backend via host.docker.internal.
# Production (gen-env-server.sh): http://backend.${APP_NETWORK_NAME}:8080/hooks/wuzapi
WUZAPI_WEBHOOK_URL=http://host.docker.internal:8080/hooks/wuzapi
WUZAPI_DB_NAME=wuzapi

# --- PDF (Gotenberg Chromium) ---
GOTENBERG_URL=http://127.0.0.1:3001
GOTENBERG_PORT=3001
# PDF fonts: embedded (Noto Sans + Noto Sans Arabic subsets inlined as data:
# URIs, default) or system (fonts installed in the Gotenberg image).
PDF_FONTS=embedded

# --- Exchange rates (worker-core scheduler, TEC-84) ---
# Daily TCMB (TRY) and ECB (EUR) reference rates; override for mirrors/tests.
RATES_TCMB_URL=https://www.tcmb.gov.tr/kurlar/today.xml
RATES_ECB_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml

# --- Warranty (worker-core scheduler, TEC-194) ---
# Look-back window (days, by completed_at) of the nightly warranty:repair_scan.
WARRANTY_REPAIR_SCAN_DAYS=30
# Public warranty page (/garanti/{public_code}, TEC-189): lookups per client
# IP per window; over the limit the API answers 429 with Retry-After.
WARRANTY_PUBLIC_RATE_LIMIT=30
WARRANTY_PUBLIC_RATE_WINDOW=1m

# --- Service review request (TEC-192) ---
# Delay between service completion and the WhatsApp Google review request
# (Go duration; sent only when the dealer has a google_business_url).
SERVICE_REVIEW_REQUEST_DELAY=24h

# --- Queue ---
QUEUE_ENABLED=true
QUEUE_CONCURRENCY=10
# Queue groups a worker consumes: critical (notifications), default (imports,
# bulk, search), low (maintenance), docs (PDF/export). Empty = every queue.
# Prod: worker-core = critical,default,low; worker-docs = WORKER_DOCS_QUEUES.
WORKER_QUEUES=
WORKER_DOCS_QUEUES=docs
# worker-docs concurrency (PDF + export tasks in parallel), prod only.
WORKER_DOCS_CONCURRENCY=20
# Periodic-task scheduler (log purge, …). A Redis lease keeps one leader.
SCHEDULER_ENABLED=true

# Bulk action engine
BULK_SYNC_MAX=50
BULK_ROLLBACK_HOURS=24
QUEUE_WORKER_INPROCESS=true

# --- CORS / public URLs ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_API_URL=http://127.0.0.1:8080
PUBLIC_FRONTEND_URL=http://localhost:3000
# BFF upstream base — must include /v1 (Go routes are /v1/...).
API_URL=http://127.0.0.1:8080/v1

# --- At-rest secret encryption (GitHub App credentials in DB) ---
# 32-byte key, raw or base64. Generate: openssl rand -base64 32
# The backend refuses to start outside development with this example value.
APP_ENCRYPTION_KEY=app-dev-encryption-key-32bytes!!

# --- Customer PII encryption (TC kimlik no / tax number, TEC-159) ---
# base64 of 32 random bytes; no default (a public key would be useless).
# Local: `make dev-pii-key` writes one into .env. Production:
# scripts/gen-env-server.sh generates it once and never rotates it
# (rotating makes every stored identity number unreadable).
CUSTOMER_PII_KEY=

# --- NextAuth (frontend session layer) ---
AUTH_SECRET=app-dev-auth-secret-change-me-32chars-min
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_ADAPTER_SECRET=app-dev-auth-adapter-secret-change-me

# --- Landing / SEO ---
# Public origin used for canonical, Open Graph, robots and sitemap URLs.
# Baked in at `next build`; compose.prod.yml falls back to AUTH_URL.
# SITE_URL=https://olexfilms.app
# Passkey RP ID; defaults to the hostname of PUBLIC_FRONTEND_URL.
AUTH_WEBAUTHN_RP_ID=localhost

# --- Frontend public (baked into the browser bundle) ---
NEXT_PUBLIC_BFF_BASE_URL=/api
NEXT_PUBLIC_REALTIME_ENABLED=true
NEXT_PUBLIC_CENTRIFUGO_URL=ws://127.0.0.1:8000/connection/websocket
NEXT_PUBLIC_DEFAULT_LOCALE=tr
# Missing keys always fall back to en (bundled); the other 12 languages load lazily.

# --- Web Push (VAPID). Required for closed-browser notifications. ---
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@example.com

# --- Notification center (TEC-87) ---
# Expo push (mobile). The access token is optional (Expo enhanced security).
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=
# HTML e-mail frame: logo (absolute URL) and header color.
NOTIFY_EMAIL_LOGO_URL=
NOTIFY_EMAIL_COLOR=#111827

# --- Glorian Inventory API client (TEC-267, design K2) ---
# Outbound sync to the Glorian hub's /api/v1/inventory. Disabled by default;
# the key is a placeholder, real value only in the server env.
GLORIAN_INVENTORY_ENABLED=false
GLORIAN_INVENTORY_BASE_URL=
GLORIAN_INVENTORY_API_KEY=change-me-inventory-api-key
# Per-attempt timeouts; GET backoff start; longest 429 Retry-After waited.
GLORIAN_INVENTORY_TIMEOUT=15s
GLORIAN_INVENTORY_WRITE_TIMEOUT=30s
GLORIAN_INVENTORY_RETRY_BASE_DELAY=200ms
GLORIAN_INVENTORY_MAX_RETRY_AFTER=60s

# --- Migrator (legacy import, F2; profile "migrator") ---
# Read-only legacy MariaDB sources (design §7, TEC-252). Placeholders only:
# real DSNs are set by hand on the server, never committed. Format is a
# go-sql-driver DSN, e.g. user:password@tcp(legacy-host:3306)/dbname. Only
# needed when a run has steps. "glorian" is registered but disabled (K2).
# MIGRATOR_ARGS overrides the container command (default: run --profile=$MIGRATOR_PROFILE).
MIGRATOR_PROFILE=olex
MIGRATOR_ARGS=
LEGACY_HUB_DSN=
LEGACY_WH_DSN=
# Legacy hub storage directory (uploaded media) as mounted in the container.
LEGACY_HUB_STORAGE_DIR=
