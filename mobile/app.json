{
  "expo": {
    "name": "Olexfilms",
    "slug": "olexfilms",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "olexfilms",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.olexfilms.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.olexfilms.app",
      "adaptiveIcon": {
        "backgroundColor": "#003d25",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "locales": {
      "tr": "./assets/locales/tr.json",
      "en": "./assets/locales/en.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f4f9f5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#091910",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#003d25"
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": [
            "tr",
            "en",
            "bg",
            "de",
            "el",
            "uk",
            "ru",
            "fr",
            "es",
            "it",
            "zh-CN",
            "az",
            "ar"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Olexfilms barkod, QR kod ve plaka okumak için kamerayı kullanır.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Olexfilms hızlı giriş için Face ID kullanır."
        }
      ],
      "expo-sqlite",
      [
        "@sfourdrinier/react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Olexfilms boya kalınlığı ölçüm cihazına (SmartPTG) bağlanmak için Bluetooth kullanır."
        }
      ],
      "expo-sharing",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.olexfilms.app.widgets",
          "groupIdentifier": "group.com.olexfilms.app",
          "widgets": [
            {
              "name": "OlexKoruma",
              "displayName": "Koruma",
              "description": "Aracınızın koruma durumu",
              "android": null,
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "contentMarginsDisabled": true,
                "configuration": {
                  "title": "Araç seçimi",
                  "parameters": {
                    "vehicle": {
                      "title": "Araç",
                      "type": "enum",
                      "dynamic": true,
                      "default": "auto",
                      "values": [
                        {
                          "name": "Otomatik",
                          "value": "auto"
                        }
                      ]
                    }
                  }
                }
              }
            },
            {
              "name": "OlexGarantiKarti",
              "displayName": "Garanti kartı",
              "description": "Garanti kartı ve geçerlilik",
              "android": null,
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "contentMarginsDisabled": true,
                "configuration": {
                  "title": "Araç seçimi",
                  "parameters": {
                    "vehicle": {
                      "title": "Araç",
                      "type": "enum",
                      "dynamic": true,
                      "default": "auto",
                      "values": [
                        {
                          "name": "Otomatik",
                          "value": "auto"
                        }
                      ]
                    }
                  }
                }
              }
            },
            {
              "name": "OlexHizmetDurumu",
              "displayName": "Hizmet durumu",
              "description": "Aracınızdaki işin adımları",
              "android": null,
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "contentMarginsDisabled": true,
                "configuration": {
                  "title": "Araç seçimi",
                  "parameters": {
                    "vehicle": {
                      "title": "Araç",
                      "type": "enum",
                      "dynamic": true,
                      "default": "auto",
                      "values": [
                        {
                          "name": "Otomatik",
                          "value": "auto"
                        }
                      ]
                    }
                  }
                }
              }
            },
            {
              "name": "OlexPanom",
              "displayName": "Panom",
              "description": "Günün özeti",
              "android": null,
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "OlexHizliIslem",
              "displayName": "Hızlı işlem",
              "description": "Tara ve hızlı işlemler",
              "android": null,
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "OlexSon30Gun",
              "displayName": "Son 30 gün",
              "description": "Son 30 günün özeti",
              "android": null,
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "OlexBekleyenler",
              "displayName": "Bekleyenler",
              "description": "Bekleyen işler ve görevler",
              "android": null,
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "OlexCiro",
              "displayName": "Ciro",
              "description": "Günlük ciro",
              "android": null,
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "contentMarginsDisabled": true
              }
            }
          ]
        }
      ],
      "expo-background-task",
      [
        "./plugins/with-caller-id",
        {
          "groupIdentifier": "group.com.olexfilms.app"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "furkanmeclis",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/c0be0362-2a3c-4f0d-abed-43c53ee780d7",
      "enabled": true,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "c0be0362-2a3c-4f0d-abed-43c53ee780d7"
      }
    }
  }
}
